---
// The landing page's "Where Arca is heading" card: one tile per column (Now, Next, Later)
// with its count and first item, and a pill to the roadmap. It reads the columns and tiles
// straight from the roadmap page's Markdown (see the comment at the top of roadmap.md), so
// adding a tile there updates this card too.
import source from "../content/docs/roadmap.md?raw";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const decode = (text: string) =>
  text
    .trim()
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, "&");

// Skip the frontmatter (its comment shows example tiles) and any HTML comments.
const body = source.replace(/^---[\s\S]*?\n---/, "").replace(/<!--[\s\S]*?-->/g, "");

const columns = body
  .split(/<section class="rm-col"/)
  .slice(1)
  .map((chunk) => {
    const id = chunk.match(/id="([^"]+)"/)?.[1] ?? "";
    const title = decode(chunk.match(/<h2[^>]*>([^<]+)<\/h2>/)?.[1] ?? id);
    const items = [...chunk.matchAll(/<div class="rm-tile">[\s\S]*?<h3[^>]*>([^<]+)<\/h3>/g)].map((m) =>
      decode(m[1]),
    );
    return { id, title, items };
  })
  .filter((column) => column.id !== "not-planned");
---

<section class="rm-teaser not-content" aria-labelledby="rm-teaser-title">
  <div class="rm-teaser__copy">
    <h2 class="rm-teaser__title" id="rm-teaser-title">Where Arca is heading</h2>
    <p class="rm-teaser__text">What's being built now, what's next, and the ideas waiting their turn. A direction, not a promise.</p>
    <a class="arca-pill arca-pill--primary rm-teaser__link" href={`${base}/roadmap/`}>See the roadmap</a>
  </div>
  <ol class="rm-teaser__phases">
    {
      columns.map((column) => (
        <li class="rm-teaser__phase" data-column={column.id}>
          <a href={`${base}/roadmap/#${column.id}`}>
            <span class="rm-teaser__chip">{column.title}</span>
            <span class="rm-teaser__count">{column.items.length}</span>
            <span class="rm-teaser__first">
              {column.items[0]}
              {column.items.length > 1 ? ` and ${column.items.length - 1} more` : ""}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .rm-teaser {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
    background-color: var(--clr-card);
    border-radius: 24px;
    padding: 1.5rem 1.375rem;
    color: var(--clr-ink);
  }
  @media (min-width: 60rem) {
    .rm-teaser {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 2rem;
    }
  }
  .rm-teaser :is(h2, p, ol, li) {
    margin: 0;
  }
  .rm-teaser ol {
    list-style: none;
    padding: 0;
  }
  .rm-teaser__title {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .rm-teaser__text {
    margin-top: 0.5rem;
    color: var(--clr-ink-2);
  }
  .rm-teaser__link {
    margin-top: 1.25rem;
  }

  .rm-teaser__phases {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
  }
  .rm-teaser__phase a {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.125rem 1.125rem;
    border-radius: 16px;
    background-color: var(--clr-tile);
    color: var(--clr-ink);
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .rm-teaser__phase a:hover {
    background-color: var(--clr-line);
  }
  .rm-teaser__chip {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    height: 1.625rem;
    padding: 0 0.625rem;
    border-radius: 999px;
    background-color: var(--clr-stone);
    color: var(--clr-stone-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }
  /* The roadmap's column dots: Now ember, Next black, Later grey. */
  [data-column="now"] .rm-teaser__chip { background-color: var(--clr-ember); color: var(--clr-ember-ink); }
  [data-column="next"] .rm-teaser__chip { background-color: var(--clr-primary); color: var(--clr-primary-ink); }
  .rm-teaser__count {
    margin-top: 0.5rem;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rm-teaser__first {
    font-size: 0.8125rem;
    color: var(--clr-muted);
  }
</style>
