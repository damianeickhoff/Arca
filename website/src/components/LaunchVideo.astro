---
// The landing page's "Arca in 20 seconds" card: the launch video (public/video/, made in
// the brain's "Launch video" folder) with English captions, and a pill to the guided tour.
// The video only loads when someone presses play.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="launch-video not-content" aria-labelledby="launch-video-title">
  <div class="launch-video__head">
    <div>
      <h2 class="launch-video__title" id="launch-video-title">Arca in 20 seconds</h2>
      <p class="launch-video__lead">From a bank export to one calm number, with the sound on.</p>
    </div>
    <a class="arca-pill arca-pill--primary arca-pill--sm" href={`${base}/demo/`}>Take the tour</a>
  </div>
  <video
    class="launch-video__player"
    controls
    playsinline
    preload="none"
    poster={`${base}/video/arca-launch-poster.jpg`}
    width="1920"
    height="1080"
  >
    <source src={`${base}/video/arca-launch.mp4`} type="video/mp4" />
    <track kind="captions" src={`${base}/video/arca-launch.en.vtt`} srclang="en" label="English" />
  </video>
</section>

<style>
  .launch-video {
    margin-top: 1.25rem;
    background-color: var(--clr-card);
    border-radius: 24px;
    padding: 1.25rem;
  }
  .launch-video__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.25rem 0.25rem 1.25rem;
  }
  :global(.sl-markdown-content) h2.launch-video__title {
    margin: 0;
    color: var(--clr-ink);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }
  :global(.sl-markdown-content) .launch-video__lead {
    margin: 0.25rem 0 0;
    color: var(--clr-ink-2);
    font-size: 0.9375rem;
  }
  .launch-video__player {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    background-color: var(--clr-tile);
  }
  @media (min-width: 50em) {
    .launch-video {
      padding: 1.5rem;
    }
  }
</style>
