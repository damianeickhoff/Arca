---
// The roadmap page: a hero card with the counts, a filter (all · AI · without AI), a
// timeline with one white card per phase and the items as tiles, and the AI ground rules.
// Content lives in src/data/roadmap.ts. Everything here is `not-content`, so Starlight's
// Markdown styles leave it alone; the page's own card wrapper is removed below.
import { phases, aiRules, feedbackUrl } from "../data/roadmap";

const total = phases.filter((p) => p.id !== "not-planned").reduce((n, p) => n + p.items.length, 0);
const aiCount = phases.filter((p) => p.id !== "not-planned").flatMap((p) => p.items).filter((i) => i.ai).length;
const counted = phases.filter((p) => p.id !== "not-planned");
---

<div class="arca-roadmap not-content" data-filter="all">
  <section class="rm-hero">
    <div class="rm-hero__copy">
      <p class="rm-hero__eyebrow">A direction, not a promise</p>
      <h2 class="rm-hero__title">Where Arca is heading.</h2>
      <p class="rm-hero__text">
        Plans change: items move between phases, change shape or get dropped. Most of what's coming
        is optional AI help, built on the <a href="#ai-ground-rules">ground rules</a> below.
      </p>
      <div class="rm-hero__actions">
        <a class="rm-pill rm-pill--hero" href={feedbackUrl}>Suggest an idea on GitHub</a>
        <a class="rm-pill rm-pill--outline" href="#ai-ground-rules">Ground rules for AI</a>
      </div>
    </div>
    <ul class="rm-hero__stats">
      {
        counted.map((phase) => (
          <li>
            <a class="rm-stat" data-tone={phase.tone} href={`#${phase.id}`}>
              <span class="rm-stat__value">{phase.items.length}</span>
              <span class="rm-stat__label">{phase.status.toLowerCase()}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="rm-toolbar">
    <div class="rm-filter" role="group" aria-label="Show">
      <button type="button" class="rm-filter__chip" data-filter="all" aria-pressed="true">All <span>{total}</span></button>
      <button type="button" class="rm-filter__chip" data-filter="ai" aria-pressed="false">With AI <span>{aiCount}</span></button>
      <button type="button" class="rm-filter__chip" data-filter="plain" aria-pressed="false">Without AI <span>{total - aiCount}</span></button>
    </div>
    <p class="rm-toolbar__hint">Items marked <span class="rm-tag">AI</span> use the optional AI and work only when you switch it on.</p>
  </div>

  <ol class="rm-timeline">
    {
      phases.map((phase) => (
        <li class="rm-phase" id={phase.id} data-tone={phase.tone}>
          <div class="rm-phase__rail" aria-hidden="true">
            <span class="rm-phase__dot" />
          </div>
          <section class="rm-phase__card" aria-labelledby={`${phase.id}-title`}>
            <header class="rm-phase__head">
              <span class="rm-chip">{phase.status}</span>
              <h2 class="rm-phase__title" id={`${phase.id}-title`}>{phase.title}</h2>
              <p class="rm-phase__lead">{phase.lead}</p>
            </header>
            <ul class="rm-items">
              {phase.items.map((item) => (
                <li class="rm-item" data-ai={item.ai ? "true" : "false"}>
                  <div class="rm-item__head">
                    <h3 class="rm-item__title">{item.title}</h3>
                    {item.ai && <span class="rm-tag">AI</span>}
                  </div>
                  <p class="rm-item__text">{item.text}</p>
                </li>
              ))}
            </ul>
            <p class="rm-phase__empty">Nothing in this phase for the current filter.</p>
          </section>
        </li>
      ))
    }
  </ol>

  <section class="rm-rules" id="ai-ground-rules" aria-labelledby="ai-ground-rules-title">
    <header class="rm-rules__head">
      <span class="rm-chip rm-chip--mint">Every AI feature</span>
      <h2 class="rm-rules__title" id="ai-ground-rules-title">Ground rules for AI</h2>
      <p class="rm-rules__lead">The same five rules apply to everything on this page that uses AI.</p>
    </header>
    <ol class="rm-rules__list">
      {
        aiRules.map((rule, i) => (
          <li class="rm-rule">
            <span class="rm-rule__n">{i + 1}</span>
            <div>
              <h3 class="rm-rule__title">{rule.title}</h3>
              <p class="rm-rule__text">{rule.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</div>

<script>
  // The filter chips: one data attribute on the root, the CSS does the hiding.
  for (const root of document.querySelectorAll<HTMLElement>(".arca-roadmap")) {
    const chips = root.querySelectorAll<HTMLButtonElement>(".rm-filter__chip");
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        root.dataset.filter = chip.dataset.filter ?? "all";
        for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
      });
    }
  }
</script>

<style>
  /* The roadmap draws its own cards, so the page's one white card wrapper goes. */
  :global(.sl-markdown-content:has(> .arca-roadmap)) {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
  }

  .arca-roadmap {
    --rail: 2rem;
    display: grid;
    gap: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--clr-ink);
  }
  .arca-roadmap :is(h2, h3, p, ul, ol, li) {
    margin: 0;
  }
  .arca-roadmap :is(ul, ol) {
    list-style: none;
    padding: 0;
  }

  /* ---- Hero: the page's one black card ---- */
  .rm-hero {
    display: grid;
    gap: 1.5rem;
    background-color: var(--clr-hero);
    color: var(--clr-hero-ink);
    border-radius: 24px;
    padding: 1.75rem 1.5rem;
  }
  @media (min-width: 60rem) {
    .rm-hero {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
      padding: 2.25rem 2.25rem;
    }
  }
  .rm-hero__eyebrow {
    color: var(--clr-hero-ink-2);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .rm-hero__title {
    margin-top: 0.375rem;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--clr-hero-ink);
  }
  .rm-hero__text {
    margin-top: 0.875rem;
    max-width: 34rem;
    color: var(--clr-hero-ink-2);
  }
  .rm-hero__text a {
    color: var(--clr-hero-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--clr-hero-ink) 45%, transparent);
    text-underline-offset: 0.2em;
  }
  .rm-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .rm-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 60rem) {
    .rm-hero__stats {
      grid-template-columns: repeat(3, 7.5rem);
    }
  }
  .rm-stat {
    display: grid;
    gap: 0.125rem;
    min-height: 6rem;
    padding: 0.875rem 1rem;
    border-radius: 16px;
    background-color: color-mix(in srgb, var(--clr-hero-ink) 8%, transparent);
    color: var(--clr-hero-ink);
    text-decoration: none;
    transition: background-color 150ms ease, transform 150ms ease;
  }
  .rm-stat:hover {
    background-color: color-mix(in srgb, var(--clr-hero-ink) 14%, transparent);
  }
  .rm-stat:active {
    transform: scale(0.98);
  }
  .rm-stat__value {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rm-stat__label {
    align-self: end;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--clr-hero-ink-2);
  }
  .rm-stat::before {
    content: "";
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background-color: var(--tone);
    margin-bottom: 0.5rem;
  }

  /* Phase tones. */
  [data-tone="ember"] { --tone: var(--clr-ember); --tone-ink: var(--clr-ember-ink); --tone-fill: var(--clr-peach); --tone-fill-ink: var(--clr-peach-ink); }
  [data-tone="sky"] { --tone: var(--clr-sky-ink); --tone-ink: var(--clr-sky); --tone-fill: var(--clr-sky); --tone-fill-ink: var(--clr-sky-ink); }
  [data-tone="lilac"] { --tone: var(--clr-lilac-ink); --tone-ink: var(--clr-lilac); --tone-fill: var(--clr-lilac); --tone-fill-ink: var(--clr-lilac-ink); }
  [data-tone="stone"] { --tone: var(--clr-placeholder); --tone-ink: var(--clr-stone); --tone-fill: var(--clr-stone); --tone-fill-ink: var(--clr-stone-ink); }

  /* ---- Pills and chips ---- */
  .rm-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    border: 1.5px solid transparent;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity 150ms ease, border-color 150ms ease, transform 150ms ease;
  }
  .rm-pill:active {
    transform: scale(0.97);
  }
  .rm-pill--hero {
    background-color: var(--clr-hero-ink);
    color: var(--clr-hero);
  }
  .rm-pill--hero:hover {
    opacity: 0.9;
  }
  .rm-pill--outline {
    color: var(--clr-hero-ink);
    border-color: color-mix(in srgb, var(--clr-hero-ink) 40%, transparent);
  }
  .rm-pill--outline:hover {
    border-color: color-mix(in srgb, var(--clr-hero-ink) 70%, transparent);
  }

  .rm-chip {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    background-color: var(--tone-fill, var(--clr-tile));
    color: var(--tone-fill-ink, var(--clr-ink));
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }
  [data-tone="ember"] .rm-chip {
    background-color: var(--clr-ember);
    color: var(--clr-ember-ink);
  }
  .rm-chip--mint {
    background-color: var(--clr-mint);
    color: var(--clr-mint-ink);
  }
  .rm-tag {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    height: 1.375rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background-color: var(--clr-mint);
    color: var(--clr-mint-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    vertical-align: middle;
  }

  /* ---- Toolbar: filter chips as a segmented control ---- */
  .rm-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }
  .rm-filter {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background-color: var(--clr-card);
  }
  .rm-filter__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--clr-ink-2);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .rm-filter__chip span {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--clr-muted);
    font-variant-numeric: tabular-nums;
  }
  .rm-filter__chip:hover {
    background-color: var(--clr-tile);
    color: var(--clr-ink);
  }
  .rm-filter__chip[aria-pressed="true"] {
    background-color: var(--clr-primary);
    color: var(--clr-primary-ink);
  }
  .rm-filter__chip[aria-pressed="true"] span {
    color: var(--clr-primary-ink);
    opacity: 0.7;
  }
  .rm-toolbar__hint {
    font-size: 0.8125rem;
    color: var(--clr-muted);
  }

  /* ---- Timeline ---- */
  .rm-timeline {
    display: grid;
    gap: 1.25rem;
  }
  .rm-phase {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 0 0.75rem;
  }
  @media (max-width: 40rem) {
    .rm-phase {
      grid-template-columns: minmax(0, 1fr);
    }
    .rm-phase__rail {
      display: none;
    }
  }
  .rm-phase__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .rm-phase__rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -1.25rem;
    width: 2px;
    border-radius: 999px;
    background-color: var(--clr-line);
  }
  .rm-timeline > .rm-phase:last-child .rm-phase__rail::before {
    bottom: auto;
    height: 2.5rem;
  }
  .rm-phase__dot {
    position: relative;
    z-index: 1;
    margin-top: 1.625rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background-color: var(--tone);
    box-shadow: 0 0 0 4px var(--clr-ground);
  }
  [data-tone="ember"] .rm-phase__dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid var(--clr-ember);
    opacity: 0.6;
    animation: rm-pulse 2.2s ease-out infinite;
  }
  [data-tone="lilac"] .rm-phase__dot {
    background-color: var(--clr-card);
    border: 2px solid var(--tone);
  }
  [data-tone="stone"] .rm-phase__dot {
    background-color: var(--clr-ground);
    border: 2px dashed var(--tone);
  }
  @keyframes rm-pulse {
    0% { transform: scale(0.85); opacity: 0.7; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-tone="ember"] .rm-phase__dot::after {
      animation: none;
    }
  }

  .rm-phase__card {
    display: grid;
    gap: 1.25rem;
    background-color: var(--clr-card);
    border-radius: 24px;
    padding: 1.5rem 1.25rem;
    scroll-margin-top: 6rem;
  }
  @media (min-width: 50em) {
    .rm-phase__card {
      padding: 1.75rem 2rem 2rem;
    }
  }
  .rm-phase__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.75rem;
  }
  .rm-phase__title {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .rm-phase__lead {
    grid-column: 1 / -1;
    margin-top: 0.375rem;
    color: var(--clr-ink-2);
  }

  .rm-items {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
  }
  .rm-item {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding: 1rem 1.125rem 1.125rem;
    border-radius: 16px;
    background-color: var(--clr-tile);
    transition: background-color 150ms ease;
  }
  .rm-item:hover {
    background-color: color-mix(in srgb, var(--clr-tile) 60%, var(--clr-line));
  }
  .rm-item__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .rm-item__title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .rm-item__text {
    font-size: 0.875rem;
    color: var(--clr-ink-2);
  }
  /* Ideas are not committed: a dashed placeholder, like the app's "projected" fills. */
  [data-tone="lilac"] .rm-item {
    background-color: transparent;
    outline: 1.5px dashed var(--clr-line);
    outline-offset: -1.5px;
  }
  [data-tone="lilac"] .rm-item:hover {
    background-color: var(--clr-tile);
  }
  /* Things decided against stay quiet. */
  [data-tone="stone"] .rm-item {
    background-color: var(--clr-stone);
  }
  [data-tone="stone"] .rm-item__title {
    color: var(--clr-stone-ink);
  }
  [data-tone="stone"] .rm-item__text {
    color: var(--clr-muted);
  }
  [data-tone="stone"] .rm-tag {
    background-color: var(--clr-card);
    color: var(--clr-muted);
  }

  /* ---- Filtering ---- */
  .rm-phase__empty {
    display: none;
    font-size: 0.875rem;
    color: var(--clr-muted);
  }
  .arca-roadmap[data-filter="ai"] .rm-item[data-ai="false"],
  .arca-roadmap[data-filter="plain"] .rm-item[data-ai="true"] {
    display: none;
  }
  .arca-roadmap[data-filter="ai"] .rm-phase:not(:has(.rm-item[data-ai="true"])) .rm-items,
  .arca-roadmap[data-filter="plain"] .rm-phase:not(:has(.rm-item[data-ai="false"])) .rm-items {
    display: none;
  }
  .arca-roadmap[data-filter="ai"] .rm-phase:not(:has(.rm-item[data-ai="true"])) .rm-phase__empty,
  .arca-roadmap[data-filter="plain"] .rm-phase:not(:has(.rm-item[data-ai="false"])) .rm-phase__empty {
    display: block;
  }

  /* ---- Ground rules ---- */
  .rm-rules {
    display: grid;
    gap: 1.25rem;
    background-color: var(--clr-card);
    border-radius: 24px;
    padding: 1.5rem 1.25rem;
    scroll-margin-top: 6rem;
  }
  @media (min-width: 50em) {
    .rm-rules {
      padding: 1.75rem 2rem 2rem;
    }
  }
  .rm-rules__head {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .rm-rules__title {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .rm-rules__lead {
    color: var(--clr-ink-2);
  }
  .rm-rules__list {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    counter-reset: rule;
  }
  .rm-rule {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.875rem;
    padding: 1rem 1.125rem 1.125rem;
    border-radius: 16px;
    background-color: var(--clr-mint);
  }
  .rm-rule__n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 12px;
    background-color: var(--clr-card);
    color: var(--clr-mint-ink);
    font-size: 0.9375rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .rm-rule__title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--clr-ink);
  }
  .rm-rule__text {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--clr-ink-2);
  }
</style>
